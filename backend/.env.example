# ---- Mode ----
# When true, the app serves synthetic logs/issues and canned AI replies.
# Set to false once Loki + Claude are wired up.
USE_MOCK=true

# ---- Log source ----
# "k8s"     = read pod logs directly from the K8s API via a kubeconfig (no Loki needed)
# "grafana" = query Loki through Grafana's datasource proxy (no cluster access needed)
# "loki"    = query a Loki endpoint directly (e.g. via kubectl port-forward)
LOG_SOURCE=k8s
K8S_NAMESPACE=telikos

# ---- K8s direct (used when LOG_SOURCE=k8s) ----
# Path to a kubeconfig you control. Blank = in-cluster SA, or ~/.kube/config.
# Prefer a read-only, namespace-scoped credential (see deploy/rbac.yaml).
KUBECONFIG=
# Optional named context within the kubeconfig.
K8S_CONTEXT=
# Lines pulled per container per poll, and the error filter applied client-side.
K8S_TAIL_LINES=200
K8S_ERROR_PATTERN=(?i)\b(error|exception|fatal|panic|traceback)\b

# ---- Grafana (used when LOG_SOURCE=grafana) ----
GRAFANA_URL=https://grafana.example.com
# Grafana service-account token with Viewer access (Bearer). Create one under
# Administration > Service accounts. Keep it secret; this file is git-ignored.
GRAFANA_TOKEN=
# UID of the Loki datasource. Find it: Connections > Data sources > (Loki) — it's in
# the page URL, or list via:  curl -H "Authorization: Bearer $TOKEN" $GRAFANA_URL/api/datasources
GRAFANA_DATASOURCE_UID=

# ---- Loki (used when LOG_SOURCE=loki) ----
# If Loki runs in-cluster, port-forward first:
#   KUBECONFIG=~/.kube/telikos-config kubectl -n monitoring port-forward svc/loki 3100:3100
LOKI_URL=http://localhost:3100
# LogQL selector for error-level lines (used by loki + grafana sources). Tune to your labels.
LOKI_QUERY={namespace="telikos"} |~ "(?i)\\b(error|exception|fatal|panic|traceback)\\b"
# How far back to look on each poll, and how often to poll.
LOOKBACK_SECONDS=300
POLL_INTERVAL_SECONDS=15
MAX_LINES_PER_POLL=1000

# ---- LLM provider ----
# "openai" or "anthropic"
LLM_PROVIDER=openai

# ---- OpenAI / Azure OpenAI ----
OPENAI_API_KEY=
# Blank = api.openai.com. Set to an Azure endpoint (https://<res>.openai.azure.com/)
# and the app auto-switches to the Azure client.
OPENAI_BASE_URL=
# Azure only — bump if a model needs a newer api-version.
OPENAI_API_VERSION=2024-10-21
# Public OpenAI: model names (gpt-4o, gpt-4o-mini).
# Azure: your DEPLOYMENT names (Azure portal > resource > Deployments).
# Google Gemini: use gemini-1.5-flash, gemini-1.5-pro, or gemini-2.0-flash-exp
OPENAI_ANALYZE_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- Anthropic (used only if LLM_PROVIDER=anthropic) ----
ANTHROPIC_API_KEY=
ANALYZE_MODEL=claude-opus-4-8
CHAT_MODEL=claude-sonnet-4-6

# ---- GitHub (code matching) ----
# Token with repo read access. If blank, falls back to the `gh` CLI (`gh auth token`).
GITHUB_TOKEN=
GITHUB_ORG=Maersk-Global

# ---- Database (analytics + knowledge base) ----
# PostgreSQL in production; blank = SQLite fallback (backend/data/usage.db) for both
# analytics and the knowledge base below. For the knowledge base to use real vector
# search, this Postgres instance needs the `vector` (pgvector) extension enabled.
DATABASE_URL=

# ---- Knowledge base (RAG) ----
# OpenAI: text-embedding-3-small, text-embedding-3-large
# Google Gemini: text-embedding-004 (latest), embedding-001
EMBEDDING_MODEL=text-embedding-3-small
KB_CONFIDENCE_THRESHOLD=0.85

# ---- Web search (Tavily) — used only when the knowledge base has no confident match ----
# Leave blank to skip web search entirely; the incident-analysis endpoint still works
# on logs + code + the model's own knowledge without it.
TAVILY_API_KEY=
WEB_SEARCH_ALLOWED_DOMAINS=kubernetes.io,spring.io,learn.microsoft.com

# ---- Server ----
CORS_ORIGINS=http://localhost:5173
